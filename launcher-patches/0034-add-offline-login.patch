@@ -0,0 +1,50 @@
+package net.minecraft.launcher.ui.popups.login;
+
+import javax.swing.*;
+import java.awt.*;
+import java.util.UUID;
+import com.mojang.authlib.GameProfile;
+
+/**
+ * Small dialog for collecting an offline username. Kept intentionally minimal;
+ * the application should integrate profile creation/selection as appropriate.
+ */
+public class OfflineLoginPopup extends JDialog {
+    public OfflineLoginPopup(Window owner) {
+        super(owner, "Offline Login", ModalityType.APPLICATION_MODAL);
+        setLayout(new BorderLayout(8,8));
+
+        JPanel input = new JPanel(new BorderLayout(4,4));
+        JTextField nameField = new JTextField();
+        input.add(new JLabel("Username:"), BorderLayout.WEST);
+        input.add(nameField, BorderLayout.CENTER);
+        add(input, BorderLayout.CENTER);
+
+        JPanel buttons = new JPanel(new FlowLayout(FlowLayout.RIGHT));
+        JButton ok = new JButton("OK");
+        JButton cancel = new JButton("Cancel");
+        buttons.add(cancel);
+        buttons.add(ok);
+        add(buttons, BorderLayout.SOUTH);
+
+        ok.addActionListener(e -> {
+            String username = nameField.getText();
+            if (username == null || username.trim().isEmpty()) {
+                JOptionPane.showMessageDialog(this, "Please enter a username", "Offline Login", JOptionPane.WARNING_MESSAGE);
+                return;
+            }
+            username = username.trim();
+            // Create a lightweight GameProfile that the launcher can pick up later.
+            GameProfile profile = new GameProfile(UUID.randomUUID(), username);
+            JOptionPane.showMessageDialog(this, "Offline profile created: " + username, "Offline Login", JOptionPane.INFORMATION_MESSAGE);
+            setVisible(false);
+            dispose();
+        });
+
+        cancel.addActionListener(e -> {
+            setVisible(false);
+            dispose();
+        });
+
+        pack();
+        setLocationRelativeTo(owner);
+    }
+}
 
